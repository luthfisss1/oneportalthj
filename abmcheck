  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 dark:bg-diy-yellow text-white dark:text-slate-950 text-xs font-bold shadow-xl">
    <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
    <span id="toastText">Berhasil</span>
